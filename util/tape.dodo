"util/zigzag.dodo" IMPORT
; tape values by default have a zero offset of 256 to not conflict with default instructions
; values are encoded with zigzag encoding + offset
256 "__UTIL_TAPE_ZERO__" ALIAS DO 
{ __UTIL_TAPE_ZERO__ } "__UTIL_TAPE_LEFT__" BUF DO 
{ __UTIL_TAPE_ZERO__ } "__UTIL_TAPE_RIGHT__" BUF DO 


"__UTIL_TAPE_END_DEFS__" GOTO DO

@__UTIL_TAPE_EXTEND_IF_ZERO__:
    "__UTIL_TAPE_EXTEND_IF_ZERO_END_" JNZ DO
    __UTIL_TAPE_ZERO__
    @__UTIL_TAPE_EXTEND_IF_ZERO_END_:
    RET DO
    
@__UTIL_TAPE_MOVE_RIGHT__:
    
    {
        __UTIL_TAPE_RIGHT__
        "__UTIL_TAPE_TEMP__" VAR DO 

    }  "__UTIL_TAPE_RIGHT__" SETBUF DO 

    {
        LEN DO "__UTIL_TAPE_TEMP_PRELEN__" VAR DO 
        __UTIL_TAPE_RIGHT__ 
        LEN DO "__UTIL_TAPE_TEMP_POSTLEN__" VAR DO
        __UTIL_TAPE_TEMP_POSTLEN__ __UTIL_TAPE_TEMP_PRELEN__ - DO
        "__UTIL_TAPE_EXTEND_IF_ZERO__" GOSUB DO

    } "__UTIL_TAPE_RIGHT__" SETBUF DO 

    { __UTIL_TAPE_LEFT__ __UTIL_TAPE_TEMP__ } "__UTIL_TAPE_LEFT__" SETBUF DO
    "__UTIL_TAPE_TEMP__" DEL DO 
    "__UTIL_TAPE_TEMP_PRELEN__" DEL DO 
    "__UTIL_TAPE_TEMP_POSTLEN__" DEL DO 
    RET DO
@__UTIL_TAPE_MOVE_LEFT__:
    {
        __UTIL_TAPE_LEFT__ 
        "__UTIL_TAPE_TEMP__" VAR DO 

    } "__UTIL_TAPE_LEFT__" SETBUF DO 

    {
        LEN DO "__UTIL_TAPE_TEMP_PRELEN__" VAR DO 
        __UTIL_TAPE_LEFT__ 
        LEN DO "__UTIL_TAPE_TEMP_POSTLEN__" VAR DO
        __UTIL_TAPE_TEMP_POSTLEN__ __UTIL_TAPE_TEMP_PRELEN__ - DO
        "__UTIL_TAPE_EXTEND_IF_ZERO__" GOSUB DO

    } "__UTIL_TAPE_LEFT__" SETBUF DO 

    { __UTIL_TAPE_RIGHT__ __UTIL_TAPE_TEMP__ } "__UTIL_TAPE_RIGHT__" SETBUF DO
    "__UTIL_TAPE_TEMP__" DEL DO 
    "__UTIL_TAPE_TEMP_PRELEN__" DEL DO 
    "__UTIL_TAPE_TEMP_POSTLEN__" DEL DO 
    RET DO

@__UTIL_TAPE_GET__:
    { __UTIL_TAPE_RIGHT__ DUP DO "__UTIL_TAPE_GET_RESULT__" VAR DO } "__UTIL_TAPE_RIGHT__" SETBUF DO

    __UTIL_TAPE_GET_RESULT__
    __UTIL_TAPE_ZERO__ - DO 
    ZIGDEC DO 
    "__UTIL_TAPE_GET_RESULT__" DEL DO
    RET DO

@__UTIL_TAPE_SET__:
    "__UTIL_TAPE_SET_ARG__" VAR DO 
    { __UTIL_TAPE_RIGHT__ POP DO __UTIL_TAPE_SET_ARG__ ZIGENC DO __UTIL_TAPE_ZERO__ + DO  } "__UTIL_TAPE_RIGHT__" SETBUF DO
    "__UTIL_TAPE_SET_ARG__" DEL DO
    RET DO

@__UTIL_TAPE_PRINT__:
    { } "__UTIL_TAPE_TEMP_LEFTPART__" BUF DO 
    LEN DO "__UTIL_TAPE_TEMP_LEFTPART_PRELEN__" VAR DO 
    __UTIL_TAPE_LEFT__
    @__UTIL_TAPE_PRINT_TEMP_LEFT_LOOP__:
        "__UTIL_TAPE_PRINT_TEMP_LEFT_LOOP_TEMPVAR__" VAR DO 
            { __UTIL_TAPE_TEMP_LEFTPART__ __UTIL_TAPE_PRINT_TEMP_LEFT_LOOP_TEMPVAR__ } "__UTIL_TAPE_TEMP_LEFTPART__" SETBUF DO
        "__UTIL_TAPE_PRINT_TEMP_LEFT_LOOP_TEMPVAR__" DEL DO 

    LEN DO __UTIL_TAPE_TEMP_LEFTPART_PRELEN__ - DO "__UTIL_TAPE_PRINT_TEMP_LEFT_LOOP__" JNZ DO 

    "[" OUTS DO 

    LEN DO "__UTIL_TAPE_LEFTPART_PRELEN__" VAR DO 
    __UTIL_TAPE_TEMP_LEFTPART__
    @__UTIL_TAPE_PRINT_LEFT_LOOP__:
        __UTIL_TAPE_ZERO__ - DO ZIGDEC DO OUTN DO
        ", " OUTS DO 

    LEN DO __UTIL_TAPE_LEFTPART_PRELEN__ - DO "__UTIL_TAPE_PRINT_LEFT_LOOP__" JNZ DO 

    "__UTIL_TAPE_LEFTPART_PRELEN__" DEL DO
    "__UTIL_TAPE_TEMP_LEFTPART_PRELEN__" DEL DO
    "__UTIL_TAPE_TEMP_LEFTPART__" DEL DO

    LEN DO "__UTIL_TAPE_RIGHTPART_PRELEN__" VAR DO 
    
    __UTIL_TAPE_RIGHT__
    
    ">" OUTS DO 
    __UTIL_TAPE_ZERO__ - DO ZIGDEC DO OUTN DO
    "<, " OUTS DO 
    LEN DO __UTIL_TAPE_RIGHTPART_PRELEN__ - DO "__UTIL_TAPE_PRINT_RIGHT_LOOP_EXIT__" JZ DO 
    @__UTIL_TAPE_PRINT_RIGHT_LOOP__:
        __UTIL_TAPE_ZERO__ - DO ZIGDEC DO OUTN DO
        ", " OUTS DO 


    LEN DO __UTIL_TAPE_RIGHTPART_PRELEN__ - DO "__UTIL_TAPE_PRINT_RIGHT_LOOP__" JNZ DO 
    @__UTIL_TAPE_PRINT_RIGHT_LOOP_EXIT__:
    "]" OUTS DO 

    "__UTIL_TAPE_RIGHTPART_PRELEN__" DEL DO

    RET DO 


@__UTIL_TAPE_END_DEFS__:

{ "__UTIL_TAPE_MOVE_RIGHT__" GOSUB } "TAPE_MVRIGHT" BUFALIAS DO 
{ "__UTIL_TAPE_MOVE_LEFT__" GOSUB } "TAPE_MVLEFT" BUFALIAS DO 
{ "__UTIL_TAPE_GET__" GOSUB } "TAPE_GET" BUFALIAS DO 
{ "__UTIL_TAPE_SET__" GOSUB } "TAPE_SET" BUFALIAS DO 
{ "__UTIL_TAPE_PRINT__" GOSUB } "TAPE_PRINT" BUFALIAS DO 