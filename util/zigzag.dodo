"__UTIL_ZIGZAG_END_DEFS__" GOTO DO

@__UTIL_ZIGZAG_ENCODE__:
    "__UTIL_ZIGZAG_INPUT__" VAR DO
    __UTIL_ZIGZAG_INPUT__ 2 * DO
    __UTIL_ZIGZAG_INPUT__ 0 < DO "__UTIL_ZIGZAG_ENCODE_NEGATIVE__" JNZ DO
    "__UTIL_ZIGZAG_INPUT__" DEL DO
    RET DO
    @__UTIL_ZIGZAG_ENCODE_NEGATIVE__:
        0 1 - DO * DO 1 - DO
        "__UTIL_ZIGZAG_INPUT__" DEL DO
        RET DO

@__UTIL_ZIGZAG_DECODE__:
    "__UTIL_ZIGZAG_INPUT__" VAR DO
    __UTIL_ZIGZAG_INPUT__ 2 % DO "__UTIL_ZIGZAG_DECODE_ODD__" JNZ DO
    __UTIL_ZIGZAG_INPUT__ 2 / DO
    "__UTIL_ZIGZAG_INPUT__" DEL DO
    RET DO 
    @__UTIL_ZIGZAG_DECODE_ODD__:
        __UTIL_ZIGZAG_INPUT__ 1 + DO
        2 / DO
        0 1 - DO * DO
        "__UTIL_ZIGZAG_INPUT__" DEL DO
        RET DO


@__UTIL_ZIGZAG_END_DEFS__:

{ "__UTIL_ZIGZAG_ENCODE__" GOSUB } "ZIGENC" BUFALIAS DO
{ "__UTIL_ZIGZAG_DECODE__" GOSUB } "ZIGDEC" BUFALIAS DO